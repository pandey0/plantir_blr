// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum EventCategory {
  POTHOLE
  GARBAGE
  WATER_LOGGING
  TRAFFIC_INCIDENT
  UNAUTHORIZED_CONSTRUCTION
  STREET_LIGHT_FAILURE
  OTHER
}

enum EventStatus {
  REPORTED
  VERIFIED
  ESCALATED
  IN_PROGRESS
  RESOLVED
  FRAUD
}

model Event {
  id               String        @id @default(uuid())
  category         EventCategory
  status           EventStatus   @default(REPORTED)
  confidence_score Int           @default(0)
  
  // We'll use a raw SQL approach for PostGIS geom column as Prisma 
  // currently has limited built-in support for Geography types, 
  // but we'll manage the column via migrations.
  
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  resolved_at      DateTime?
  
  metadata         Json?         // Extensible field for ward_id, etc.
  
  reports          Report[]
  evidence         Evidence[]

  @@index([status])
  @@index([category])
  @@index([created_at])
  // Backs events/geo-query.ts's findDuplicateCandidateEventId() — the WHERE category = ? AND
  // status = ANY(...) AND created_at >= ? query that runs on every POST /v1/events. A single
  // composite index serves this better than Postgres combining the separate [status]/[category]
  // indexes via a bitmap AND, since this exact 3-column combination is the query's actual shape.
  @@index([category, status, created_at])
}

model Report {
  id          String   @id @default(uuid())
  event_id    String
  user_id     String   // Can be an anonymous device ID or user account
  description String?
  created_at  DateTime @default(now())

  event       Event    @relation(fields: [event_id], references: [id])

  // Postgres does NOT auto-index foreign key columns (a common gotcha) — recalculateConfidence()
  // queries report.findMany({ where: { event_id } }) on every event create/update, so this was a
  // real missing index, not a precaution.
  @@index([event_id])
}

model Evidence {
  id                String   @id @default(uuid())
  event_id          String
  media_url         String
  is_authority_proof Boolean  @default(false)
  created_at        DateTime @default(now())

  event             Event    @relation(fields: [event_id], references: [id])

  // Same reasoning as Report.event_id above — evidence.count({ where: { event_id } }) runs on
  // every confidence recalculation.
  @@index([event_id])
}
